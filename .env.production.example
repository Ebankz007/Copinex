# Copinex - PRODUCTION environment template.
# Copy to the production host, fill every value, and NEVER commit this file.
# The API refuses to boot in NODE_ENV=production with any dev placeholder
# value or with the Pay2Crypto rail unconfigured - this file is the checklist.

# ── Core ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL 16) ─────────────────────────
# Production DB - NOT the dev credentials. Create a dedicated role with
# least privilege (SELECT/INSERT/UPDATE on app tables, no DROP).
DATABASE_URL=postgresql://copinex:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5433/copinex

# ── Redis (Phase 4 - not required for investment accrual) ──
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_48_BYTE_RANDOM
JWT_EXPIRES_IN=7d

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info

# ── Pay2Crypto crypto rail (Q4) ──────────────────────
# ALL THREE are REQUIRED in production - the API refuses to boot without
# them (mock mode is development-only). Token from app.pay2crypto.com
# (merchant account, scoped token). Webhook secret: openssl rand -base64 32.
PAY2CRYPTO_API_URL=https://api.pay2crypto.com
PAY2CRYPTO_TOKEN=REPLACE_WITH_MERCHANT_TOKEN
PAY2CRYPTO_WEBHOOK_SECRET=REPLACE_WITH_32_BYTE_RANDOM

# ── Public URL ────────────────────────────────────────
# Used to build links in transactional email (email verification,
# password reset). No trailing slash. Must be reachable by members.
APP_URL=https://www.copinex.com

# ── Transactional email (SMTP) ────────────────────────
# REQUIRED in production: the API throws on boot without it, because
# password reset and address verification are unusable without a real
# delivery path. Format: smtps://user:password@host:465
# The password MUST be percent-encoded if it contains @ or /.
# Emails sent: email verification, password reset, password changed,
# notification fan-out (announcements).
SMTP_URL=smtps://REPLACE_USER:REPLACE_PASSWORD@smtp.example.com:465

# Envelope sender on all transactional mail. Must be a domain you control
# (SPF/DKIM) or deliverability collapses.
EMAIL_FROM=Copinex <no-reply@copinex.com>
