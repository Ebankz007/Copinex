# Copinex - PRODUCTION environment template.
# Copy to the production host, fill every value, and NEVER commit this file.
# The API refuses to boot in NODE_ENV=production with any dev placeholder
# value or with the Pay2Crypto rail unconfigured - this file is the checklist.

# ── Core ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL 16) ─────────────────────────
# Production DB - NOT the dev credentials. Create a dedicated role with
# least privilege (SELECT/INSERT/UPDATE on app tables, no DROP).
DATABASE_URL=postgresql://copinex:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5433/copinex

# ── Redis (Phase 4 - not required for investment accrual) ──
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_48_BYTE_RANDOM
JWT_EXPIRES_IN=7d
# TLS terminates at the reverse proxy in production, so trust its
# X-Forwarded-For for rate limiting and audit IPs. NEVER enable this when
# the API is directly exposed (clients could spoof past the limiters).
TRUST_PROXY=1

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=info

# ── Pay2Crypto crypto rail (Q4) ──────────────────────
# ALL THREE are REQUIRED in production - the API refuses to boot without
# them (mock mode is development-only). Token from app.pay2crypto.com
# (merchant account, scoped token). Webhook secret: openssl rand -base64 32.
PAY2CRYPTO_API_URL=https://api.pay2crypto.com
PAY2CRYPTO_TOKEN=REPLACE_WITH_MERCHANT_TOKEN
PAY2CRYPTO_WEBHOOK_SECRET=REPLACE_WITH_32_BYTE_RANDOM

# ── Public URL ────────────────────────────────────────
# Used to build links in transactional email (email verification,
# password reset). No trailing slash. Must be reachable by members.
APP_URL=https://www.copinex.com

# ── Transactional email (SMTP provider) ─────────────
# TWO approved providers (either works — the app speaks plain SMTP, so the
# choice is a URL + credentials, never a code change):
#
#   A. SMTP.com relay — host send.smtp.com, SENDER login + password from the
#      SMTP.com dashboard (NOT the account login):
#        SMTP_URL=smtp://SENDER_LOGIN:SENDER_PASSWORD@send.smtp.com:2525
#        SMTP_URL=smtps://SENDER_LOGIN:SENDER_PASSWORD@send.smtp.com:465
#      (Ports 25/2525 STARTTLS, 465 implicit TLS. Entry 50k/mo at $25.)
#
#   B. Mailgun relay — host smtp.mailgun.org (US) or smtp.eu.mailgun.org
#      (EU, must match the domain's region). Credentials are PER-DOMAIN:
#      default username postmaster@<your-domain> (customizable), password
#      auto-generated in Sending → Domain Settings → SMTP Credentials:
#        SMTP_URL=smtp://postmaster@mail.copinex.com:SMTP_PASSWORD@smtp.mailgun.org:587
#        SMTP_URL=smtps://postmaster@mail.copinex.com:SMTP_PASSWORD@smtp.mailgun.org:465
#      (Ports 587 STARTTLS recommended, 2525 alt, 465 implicit TLS. Free
#      100/day tier covers dev + pilot; Basic 10k/mo at $15.)
#
# Percent-encode the password if it contains @ / : or ?.
# REQUIRED in production: the API throws on boot without it, because
# password reset and address verification are unusable without a real
# delivery path.
# Emails sent: email verification, password reset, password changed,
# notification fan-out (announcements).
SMTP_URL=smtps://REPLACE_SENDER_LOGIN:REPLACE_SENDER_PASSWORD@send.smtp.com:465

# Envelope sender on all transactional mail. Must be a domain you control
# (SPF/DKIM) or deliverability collapses. Bare address only (validated).
EMAIL_FROM=no-reply@copinex.com
# Where member replies go. Unset = replies go to the from address above
# (a no-reply sender) and bounce. Set this to a monitored support inbox.
EMAIL_REPLY_TO=Copinex Support <support@copinex.com>
