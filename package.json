{
  "name": "copinex-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Copinex compensation platform — engine, API, dashboards",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @copinex/api dev",
    "dev:web": "pnpm --filter @copinex/web dev",
    "db:generate": "pnpm --filter @copinex/database generate",
    "db:migrate": "pnpm --filter @copinex/database migrate",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  }
}