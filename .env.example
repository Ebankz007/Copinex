# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ─────────────────────────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://copinex:copinex_dev_password@localhost:5433/copinex

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_2FA_SECRET=

# ── Compensation engine ───────────────────────────────
# All values in integer cents unless noted. Overrides only if business rules change.
REGISTRATION_FEE_CENTS=5000
MIN_FUNDING_CENTS=5000
MATRIX_WIDTH=3
MATRIX_DEPTH=3
MAX_LEG_CONTRIBUTION=0.40
GENERATION_LEVELS=2-6

# Active Member policy (pending compliance sign-off)
ACTIVE_MEMBER_INACTIVITY_DAYS=90

# ── Third-party (Phase 4 — placeholders, never commit real keys) ──
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
BROKER_API_URL=
BROKER_API_KEY=

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info